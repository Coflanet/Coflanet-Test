# ============================================================
# VibeCraft2204 Internal Files
# ============================================================
# 이 파일에 나열된 패턴은 origin(고객사) 레포로 절대 전송되지 않습니다.
# publish-upstream 워크플로우가 이 파일을 읽어 자동으로 제외합니다.
#
# 형식: .gitignore와 동일한 glob 패턴
# ============================================================

# --- VibeCraft 마커 및 설정 ---
vibecraft.ignore
.vibecraft/
.claude/
.codex/
.gitattributes

# --- VibeCraft 전용 워크플로우 ---
.github/workflows/vibecraft-guard.yml
.github/workflows/publish-upstream.yml
.github/workflows/vibecraft-secure.yml
.github/workflows/sync-tag-release.yml
# pr-policy-check.yml은 upstream에서도 동작해야 하므로 제외하지 않음

# --- VibeCraft 내부 문서 ---
CLAUDE.md
CHANGELOG.md
VIBECRAFT.md

# --- 민감 파일 (secret-patterns) ---
.env
.env.local
.env.production
.env.staging
credentials.json
service-account.json
*.pem
AGENTS.md
GEMINI.md
.mcp.json
