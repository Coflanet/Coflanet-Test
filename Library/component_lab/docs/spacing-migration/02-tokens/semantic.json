{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "1.0.0",
  "spacing": {
    "stack": {
      "xs": {
        "$value": "{spacing.2}",
        "$type": "dimension",
        "$description": "Label-Value 미세 세로 간격"
      },
      "sm": {
        "$value": "{spacing.4}",
        "$type": "dimension",
        "$description": "Heading-Description 세로 간격"
      },
      "md": {
        "$value": "{spacing.8}",
        "$type": "dimension",
        "$description": "List item 사이 세로 간격"
      },
      "lg": {
        "$value": "{spacing.16}",
        "$type": "dimension",
        "$description": "Card 사이, Heading-Body 세로 간격"
      },
      "xl": {
        "$value": "{spacing.24}",
        "$type": "dimension",
        "$description": "Section 사이 세로 간격"
      }
    },
    "inline": {
      "xs": {
        "$value": "{spacing.2}",
        "$type": "dimension",
        "$description": "수평 미세 간격"
      },
      "sm": {
        "$value": "{spacing.4}",
        "$type": "dimension",
        "$description": "Icon-text 표준 수평 간격"
      },
      "md": {
        "$value": "{spacing.8}",
        "$type": "dimension",
        "$description": "Button/Chip group 수평 간격"
      },
      "lg": {
        "$value": "{spacing.12}",
        "$type": "dimension",
        "$description": "수평 강조 간격"
      }
    },
    "inset": {
      "xs": {
        "$value": "{spacing.4}",
        "$type": "dimension",
        "$description": "Tag/Badge 4방향 패딩"
      },
      "sm": {
        "$value": "{spacing.8}",
        "$type": "dimension",
        "$description": "작은 컨테이너 4방향 패딩"
      },
      "md": {
        "$value": "{spacing.12}",
        "$type": "dimension",
        "$description": "Icon Button 표준 4방향 패딩"
      },
      "lg": {
        "$value": "{spacing.16}",
        "$type": "dimension",
        "$description": "FAB / Card 표준 4방향 패딩"
      },
      "xl": {
        "$value": "{spacing.24}",
        "$type": "dimension",
        "$description": "Modal 4방향 패딩"
      }
    },
    "inset-squish": {
      "xs": {
        "vertical": {
          "$value": "{spacing.2}",
          "$type": "dimension",
          "$description": "Badge 세로"
        },
        "horizontal": {
          "$value": "{spacing.6}",
          "$type": "dimension",
          "$description": "Badge 가로"
        }
      },
      "sm": {
        "vertical": {
          "$value": "{spacing.7}",
          "$type": "dimension",
          "$description": "Button Small 세로"
        },
        "horizontal": {
          "$value": "{spacing.14}",
          "$type": "dimension",
          "$description": "Button Small 가로"
        }
      },
      "md": {
        "vertical": {
          "$value": "{spacing.9}",
          "$type": "dimension",
          "$description": "Button Medium 세로"
        },
        "horizontal": {
          "$value": "{spacing.20}",
          "$type": "dimension",
          "$description": "Button Medium 가로"
        }
      },
      "lg": {
        "vertical": {
          "$value": "{spacing.12}",
          "$type": "dimension",
          "$description": "Button Large 세로"
        },
        "horizontal": {
          "$value": "{spacing.28}",
          "$type": "dimension",
          "$description": "Button Large 가로"
        }
      }
    },
    "layout": {
      "sm": {
        "$value": "{spacing.24}",
        "$type": "dimension",
        "$description": "Section 간격"
      },
      "md": {
        "$value": "{spacing.32}",
        "$type": "dimension",
        "$description": "Section 큰 간격"
      },
      "lg": {
        "$value": "{spacing.40}",
        "$type": "dimension",
        "$description": "Layout 큰 간격"
      },
      "xl": {
        "$value": "{spacing.48}",
        "$type": "dimension",
        "$description": "Layout 최대 간격"
      }
    }
  }
}
